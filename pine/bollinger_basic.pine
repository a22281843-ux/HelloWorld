//@version=6
indicator("기본", overlay=true)

// === 1. 볼린저 밴드 1 설정 ===
grp_bb1 = "볼린저 밴드 1"
length1 = input.int(20, title="길이", minval=1, group=grp_bb1)
mult1 = input.float(2.0, title="표준편차 배수", minval=0.1, group=grp_bb1)
src1 = input.source(open, title="계산 기준 값", group=grp_bb1)
show_bb1 = input.bool(true, title="표시", inline="bb1_style", group=grp_bb1)
color_bb1 = input.color(#D34A4C, title="", inline="bb1_style", group=grp_bb1)
width_bb1 = input.int(1, title="두께", minval=1, maxval=4, inline="bb1_style", group=grp_bb1)

// === 2. 볼린저 밴드 2 설정 ===
grp_bb2 = "볼린저 밴드 2"
length2 = input.int(4, title="길이", minval=1, group=grp_bb2)
mult2 = input.float(4.0, title="표준편차 배수", minval=0.1, group=grp_bb2)
src2 = input.source(open, title="계산 기준 값", group=grp_bb2)
show_bb2 = input.bool(true, title="표시", inline="bb2_style", group=grp_bb2)
color_bb2 = input.color(#FFFFFF, title="", inline="bb2_style", group=grp_bb2)
width_bb2 = input.int(3, title="두께", minval=1, maxval=4, inline="bb2_style", group=grp_bb2)

squeeze_ratio = input.float(0.8, title="수축 비율", minval=0.01, maxval=0.99)

// === 3. 밴드 계산 ===
// 볼린저 밴드 1
ma1 = ta.sma(src1, length1)
stdev1 = ta.stdev(src1, length1)
upper_band1 = ma1 + stdev1 * mult1
lower_band1 = ma1 - stdev1 * mult1

// 볼린저 밴드 2 (터치·수축 신호 기준)
ma2 = ta.sma(src2, length2)
stdev2 = ta.stdev(src2, length2)
upper_band2 = ma2 + stdev2 * mult2
lower_band2 = ma2 - stdev2 * mult2

bandwidth = upper_band2 - lower_band2
prev_bandwidth = bandwidth[1]

sma20 = ta.sma(close, 20)
sma120 = ta.sma(close, 120)

// === 4. 터치 조건 ===
is_touch_upper = high >= upper_band2 and high[1] < upper_band2[1]
is_touch_lower = low <= lower_band2 and low[1] > lower_band2[1]

is_squeezed = bandwidth < prev_bandwidth * squeeze_ratio

gold_cross = ta.crossover(sma20, sma120)
dead_cross = ta.crossunder(sma20, sma120)

var bool wait_gc = false
var bool wait_dc = false

if gold_cross
    wait_gc := true
    wait_dc := false

if dead_cross
    wait_dc := true
    wait_gc := false

is_sma20_up = sma20 > sma20[1]
is_sma20_down = sma20 < sma20[1]

alert_sq_upper = is_squeezed and is_touch_upper
alert_sq_lower = is_squeezed and is_touch_lower
alert_gc_first = wait_gc and is_touch_lower
alert_dc_first = wait_dc and is_touch_upper
alert_simple_upper = is_touch_upper
alert_simple_lower = is_touch_lower
alert_double_buy = is_sma20_up and is_touch_lower
alert_double_sell = is_sma20_down and is_touch_upper

if alert_gc_first
    wait_gc := false

if alert_dc_first
    wait_dc := false

// === 5. 시각화 ===
plot(sma20, title="20 SMA", color=#F6EC62, linewidth=1)
plot(sma120, title="120 SMA", color=#5361F5, linewidth=2)

// 볼린저 밴드는 상단·하단을 인풋 탭의 그룹 하나로 함께 설정 (모습 탭에서는 숨김)
plot(show_bb1 ? upper_band1 : na, title="볼린저 밴드 1 상단", color=color_bb1, linewidth=width_bb1, editable=false)
plot(show_bb1 ? lower_band1 : na, title="볼린저 밴드 1 하단", color=color_bb1, linewidth=width_bb1, editable=false)

plot(show_bb2 ? upper_band2 : na, title="볼린저 밴드 2 상단", color=color_bb2, linewidth=width_bb2, editable=false)
plot(show_bb2 ? lower_band2 : na, title="볼린저 밴드 2 하단", color=color_bb2, linewidth=width_bb2, editable=false)

plotshape(alert_sq_upper, style=shape.triangledown, location=location.abovebar, color=#FFFFFF, title="수축 상단")
plotshape(alert_sq_lower, style=shape.triangleup, location=location.belowbar, color=#FFFFFF, title="수축 하단")
plotshape(alert_gc_first, style=shape.diamond, location=location.belowbar, color=#F6EC62, title="골크 첫터치")
plotshape(alert_dc_first, style=shape.diamond, location=location.abovebar, color=#D34A4C, title="데크 첫터치", display=display.none)

// === 6. 알림 ===
alertcondition(alert_sq_upper, "1. 수축후 상단터치", "수축원비 매도!")
alertcondition(alert_sq_lower, "2. 수축후 하단터치", "수축원비 매수!")
alertcondition(alert_gc_first, "3. 골크후 첫 하단터치", "골든크로스 이후 첫 번째 원비!")
alertcondition(alert_dc_first, "4. 데크후 첫 상단터치", "데드크로스 이후 첫 번째 원비!")
alertcondition(alert_simple_upper, "5. 상단원비 터치", "상단원비!")
alertcondition(alert_simple_lower, "6. 하단원비 터치", "하단원비!")
alertcondition(alert_double_buy, "7. 기본더블비 매수", "기본더블비 매수!")
alertcondition(alert_double_sell, "8. 기본더블비 매도", "기본더블비 매도!")
